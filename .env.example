DATABASE_URL="postgresql://patterngard:patterngard@localhost:5432/patterngard?schema=public"
# Prisma Postgres: use pooled host for the app (pooled.db.prisma.io). Keep DIRECT_URL
# as db.prisma.io for migrations / prisma.config.ts.
# DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Auth.js (required for sign-in)
AUTH_SECRET="generate-a-long-random-secret"
# Optional dedicated key for encrypting user Gemini secrets (falls back to AUTH_SECRET)
ENCRYPTION_KEY=""

# OAuth — create apps at GitHub / Google Cloud Console
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: local/dev only Gemini fallback when a user has no BYO key
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Web Push (Settings → Enable notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Vercel Cron authorization for /api/cron/review-reminders
CRON_SECRET="generate-another-secret"

NEW_PROBLEMS_PER_DAY="3"
REVIEW_GRACE_DAYS="3"
BOSS_REASONING_SECONDS="900"
BOSS_CODING_SECONDS="1200"
NEXT_PUBLIC_BOSS_REASONING_SECONDS="900"
NEXT_PUBLIC_BOSS_CODING_SECONDS="1200"
